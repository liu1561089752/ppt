# ChatPPT 环境变量模板
#
# 用法:cp .env.example .env 后填写真实值。
# 纪律(旧仓事故教训):
#   - .env 已在 .gitignore 中,绝不入库;
#   - 每台机器各持一份、字段契约一致,**不要**在机器之间手工复制 .env
#     (PROJECT_ROOT / DATABASE_URL / NATIVE_ENGINE_DIR 都带环境相关的路径);
#   - 生产环境(NODE_ENV=production)下 src/lib/config.ts 会拒绝 Windows 风格路径;
#     开发机(Windows)不受此限,见 config.ts 的 assertEnvSafety。

# ========== 必填 ==========

# 会话签名密钥(≥32 字符;缺失时服务拒绝启动)。生成: openssl rand -hex 32
JWT_SECRET=

# 项目根目录(绝对路径)。生产环境必须显式指定:
# standalone 启动后 cwd 会切到 .next/standalone,不设会把 db/ 与产物目录解析到构建产物里。
#   云服务器: PROJECT_ROOT=/home/chatppt/app
PROJECT_ROOT=

# SQLite 数据库。生产用绝对路径,且父目录必须存在:
#   DATABASE_URL=file:/home/chatppt/data/custom.db
# 本地开发可用相对路径(相对 prisma/schema.prisma):
#   DATABASE_URL=file:../db/custom.db
DATABASE_URL=

# ========== 原生 PPTX 引擎 ==========

# 引擎目录(含 cli.js 的目录)。默认 ../pptx/native(与站点同仓的兄弟目录)。
# 部署时必须把引擎目录与站点一起拷上服务器,并显式指向它:
#   NATIVE_ENGINE_DIR=/home/chatppt/app/engine
NATIVE_ENGINE_DIR=../pptx/native

# 引擎子进程超时(毫秒),默认 180000。25 页带图约 3 秒构建,留足余量给慢盘。
# NATIVE_BUILD_TIMEOUT_MS=180000

# 构建并发上限(同时在跑的引擎子进程数),默认 1。2 核 2G 服务器保持 1。
# NATIVE_BUILD_CONCURRENCY=1

# 可选:LibreOffice 的 soffice 可执行文件。配置后才会生成逐页 PNG 预览与深度版式校验;
# 不配则只用引擎自带的结构校验(不阻断生成)。
#   Windows: C:\Users\<you>\AppData\Local\LibreOffice\program\soffice.exe
#   Linux:   /usr/bin/soffice
LIBREOFFICE_SOFFICE=

# 仅测试用:置 1 时调研/规划/规格三个阶段返回确定性 fixture,不调用任何 LLM。
# NATIVE_MOCK_LLM=1

# ========== LLM 与搜索 ==========

# 主力 LLM:DeepSeek(删掉本段即整体回退 Kimi)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# DeepSeek API 地址(可选,代码读取并默认 https://api.deepseek.com;走中转/代理时改这里)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 联网搜索:博查 Web Search(主力;不配则回退 Kimi 搜索,再不行走知识摘要)
BOCHA_API_KEY=

# Kimi / Moonshot:搜索兜底 + LLM 备用
KIMI_BASE_URL=https://api.moonshot.cn
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6

# 配图:Unsplash(可选;不配则生成时自动跳过配图)
UNSPLASH_ACCESS_KEY=

# ========== 首次初始化管理员(仅 scripts/seed-admin.mjs 读取) ==========
# ADMIN_PASSWORD 必填、无默认值(至少 8 位);初始化完成后请从 .env 移除
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@chatppt.local

# ========== 运维开关(可选) ==========

# 是否信任反代注入的 x-forwarded-for:默认不信任(安全缺省,直连/未配置时
# 所有请求按 'direct' 共享限流桶);仅当部署在可信反代(Caddy/Nginx)之后才
# 显式开启 TRUST_PROXY=true —— 开启后取 XFF 最右段(最近一跳代理写入,最难伪造)
# TRUST_PROXY=true

# 打印 SQL(仅调试)
# DB_DEBUG=query

# ========== 发布冒烟(scripts/release-smoke.mjs 读取,非服务端必需) ==========
# BASE_URL=http://127.0.0.1:3000
# SMOKE_USER=admin
# SMOKE_PASS=<管理员密码>
# SMOKE_TOPIC=红茶与咖啡的全球贸易简史
# SMOKE_SLIDES=8
# 冒烟对产物体积的下限断言(字节;不写则用脚本内默认值)
# SMOKE_MIN_BYTES=20000
NATIVE_DENSITY_REPAIR=1
