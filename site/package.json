{
  "name": "chatppt-v2",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "postbuild": "node scripts/postbuild-standalone.mjs",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:pipeline": "tsx --test src/lib/pipeline/review.test.ts src/lib/pipeline/vision.test.ts src/lib/pipeline/spec-merge.test.ts src/lib/pipeline/quality-loop.test.ts src/lib/pipeline/design.test.ts src/lib/pipeline/contrast.test.ts src/lib/pipeline/fit.test.ts src/lib/pipeline/native.test.ts src/lib/pipeline/sources.test.ts",
    "prebuild": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "engine:doctor": "node scripts/engine-doctor.mjs",
    "e2e:native": "tsx scripts/e2e-native.ts",
    "e2e:pipeline": "tsx --conditions=react-server scripts/e2e-pipeline.ts",
    "smoke": "node scripts/release-smoke.mjs",
    "verify": "bun run typecheck && bun run lint && bun run test:pipeline && bun run test:recipes && bun run test:visual && bun run engine:doctor && bun run e2e:native && bun run e2e:pipeline",
    "test:recipes": "tsx scripts/recipe-probe.ts",
    "test:visual": "tsx scripts/visual-baseline.ts"
  },
  "dependencies": {
