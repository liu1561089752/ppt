{
  "name": "ppt-native-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Editable native PowerPoint generation engine for the ppt skill",
  "main": "index.js",
  "scripts": {
    "test": "node --test ../tests/native_engine.test.js",
    "demo": "node ../examples/native_demo.js native-demo.pptx",
    "demo:components": "node ../examples/native_components_demo.js native-components-demo.pptx",
    "render:demo": "python scripts/render_check.py native-demo.pptx --output-dir render-check/native-demo",
    "render:components": "python scripts/render_check.py native-components-demo.pptx --output-dir render-check/native-components-demo",
    "batch:example": "node ../batch_native_pptx.js --input ../examples/native_deck.json --output-dir batch-dist",
    "render:batch": "python scripts/render_check.py batch-dist/native_deck.pptx --output-dir render-check/batch",
    "demo:theme": "node ../examples/native_design_migration_demo.js native-theme-profile/theme.json native-design-migration-demo.pptx",
    "render:theme": "python scripts/render_check.py native-design-migration-demo.pptx --output-dir render-check/native-design-migration-demo",
    "demo:parity": "node ../examples/native_design_parity_demo.js native-theme-profile/theme.json native-design-parity-demo.pptx",
    "render:parity": "python scripts/render_check.py native-design-parity-demo.pptx --output-dir render-check/native-design-parity-demo",
    "demo:layouts": "node ../examples/native_layouts_demo.js native-layouts-demo.pptx",
    "render:layouts": "python scripts/render_check.py native-layouts-demo.pptx --output-dir render-check/native-layouts-demo",
    "demo:images": "node ../examples/native_images_demo.js native-images-demo.pptx",
    "render:images": "python scripts/render_check.py native-images-demo.pptx --output-dir render-check/native-images-demo",
    "demo:stress": "node ../examples/native_stress_deck.js native-stress-deck.pptx",
    "render:stress": "python scripts/render_check.py native-stress-deck.pptx --output-dir render-check/native-stress-deck",
    "audit:images": "node scripts/audit_deck.js native-images-demo.pptx",
    "audit:stress": "node scripts/audit_deck.js native-stress-deck.pptx --fail-on-warning",
    "verify:pictures": "node scripts/inspect_pictures.js native-images-demo.pptx",
    "pipeline:deck": "node pipeline/cli.js ../examples/pipeline-reference.html --out pipeline-converted/deck.json --report pipeline-converted/report.json",
    "pipeline:pptx": "node pipeline/cli.js ../examples/pipeline-reference.html --out pipeline-converted/deck.json --report pipeline-converted/report.json --pptx pipeline-converted/pipeline-converted.pptx",
    "pipeline:parity": "node pipeline/cli.js ../examples/design-reference.html --out pipeline-converted/parity.json --pptx pipeline-converted/pipeline-parity.pptx",
    "audit:pipeline": "node scripts/audit_deck.js pipeline-converted/pipeline-converted.pptx --min-text-shapes 2",
    "render:pipeline": "python scripts/render_check.py pipeline-converted/pipeline-converted.pptx --output-dir render-check/pipeline-converted",
    "preview:demo": "python scripts/preview_deck.py native-demo.pptx --output-dir preview/native-demo --sheet preview/native-demo-sheet.png",
    "preview:stress": "python scripts/preview_deck.py native-stress-deck.pptx --output-dir preview/stress --sheet preview/stress-sheet.png",
    "preview:images": "python scripts/preview_deck.py native-images-demo.pptx --output-dir preview/images --sheet preview/images-sheet.png",
    "preview:pipeline": "python scripts/preview_deck.py pipeline-converted/pipeline-converted.pptx --output-dir preview/pipeline --sheet preview/pipeline-sheet.png",
    "preview:components": "python scripts/preview_deck.py native-components-demo.pptx --output-dir preview/components --sheet preview/components-sheet.png",
    "preview:layouts": "python scripts/preview_deck.py native-layouts-demo.pptx --output-dir preview/layouts --sheet preview/layouts-sheet.png",
    "preview:parity": "python scripts/preview_deck.py native-design-parity-demo.pptx --output-dir preview/parity --sheet preview/parity-sheet.png",
    "preview:theme": "python scripts/preview_deck.py native-design-migration-demo.pptx --output-dir preview/theme --sheet preview/theme-sheet.png",
    "preview:all": "npm run preview:demo && npm run preview:components && npm run preview:theme && npm run preview:parity && npm run preview:layouts && npm run preview:images && npm run preview:pipeline-stress && npm run preview:pipeline && npm run preview:chart && npm run preview:decor && npm run preview:grid && npm run preview:structural && npm run preview:indent && npm run preview:wrap && npm run preview:pipeline-vertical && npm run preview:pipeline-float && npm run preview:pipeline-relative",
    "pipeline:chart": "node pipeline/cli.js ../examples/pipeline-chart.html --out pipeline-converted/chart.json --report pipeline-converted/chart-report.json --pptx pipeline-converted/pipeline-chart.pptx",
    "preview:chart": "python scripts/preview_deck.py pipeline-converted/pipeline-chart.pptx --output-dir preview/chart --sheet preview/chart-sheet.png",
    "render:chart": "python scripts/render_check.py pipeline-converted/pipeline-chart.pptx --output-dir render-check/pipeline-chart",
    "render:all": "npm run render:demo && npm run render:components && npm run render:theme && npm run render:parity && npm run render:layouts && npm run render:images && npm run render:pipeline-stress && npm run render:pipeline && npm run render:chart && npm run render:decor && npm run render:grid && npm run render:structural && npm run render:indent && npm run render:wrap && npm run render:pipeline-vertical && npm run render:pipeline-float && npm run render:pipeline-relative",
    "pipeline:decor": "node pipeline/cli.js ../examples/pipeline-decorations.html --out pipeline-converted/decorations.json --pptx pipeline-converted/pipeline-decorations.pptx",
    "preview:decor": "python scripts/preview_deck.py pipeline-converted/pipeline-decorations.pptx --output-dir preview/decor --sheet preview/decor-sheet.png",
    "render:decor": "python scripts/render_check.py pipeline-converted/pipeline-decorations.pptx --output-dir render-check/pipeline-decorations",
    "pipeline:grid": "node pipeline/cli.js ../examples/pipeline-grid.html --out pipeline-converted/grid.json --pptx pipeline-converted/pipeline-grid.pptx",
    "preview:grid": "python scripts/preview_deck.py pipeline-converted/pipeline-grid.pptx --output-dir preview/grid --sheet preview/grid-sheet.png",
    "render:grid": "python scripts/render_check.py pipeline-converted/pipeline-grid.pptx --output-dir render-check/pipeline-grid",
    "pipeline:structural": "node pipeline/cli.js ../examples/pipeline-structural.html --out pipeline-converted/structural.json --pptx pipeline-converted/pipeline-structural.pptx",
    "preview:structural": "python scripts/preview_deck.py pipeline-converted/pipeline-structural.pptx --output-dir preview/structural --sheet preview/structural-sheet.png",
    "render:structural": "python scripts/render_check.py pipeline-converted/pipeline-structural.pptx --output-dir render-check/pipeline-structural",
    "pipeline:indent": "node pipeline/cli.js ../examples/pipeline-indent.html --out pipeline-converted/indent.json --pptx pipeline-converted/pipeline-indent.pptx",
    "preview:indent": "python scripts/preview_deck.py pipeline-converted/pipeline-indent.pptx --output-dir preview/indent --sheet preview/indent-sheet.png",
    "render:indent": "python scripts/render_check.py pipeline-converted/pipeline-indent.pptx --output-dir render-check/pipeline-indent",
    "pipeline:wrap": "node pipeline/cli.js ../examples/pipeline-wrap.html --out pipeline-converted/wrap.json --pptx pipeline-converted/pipeline-wrap.pptx",
    "preview:wrap": "python scripts/preview_deck.py pipeline-converted/pipeline-wrap.pptx --output-dir preview/wrap --sheet preview/wrap-sheet.png",
    "render:wrap": "python scripts/render_check.py pipeline-converted/pipeline-wrap.pptx --output-dir render-check/pipeline-wrap",
    "pipeline:stress": "node pipeline/cli.js ../examples/pipeline-stress.html --out pipeline-converted/stress.json --pptx pipeline-converted/pipeline-stress.pptx",
    "preview:pipeline-stress": "python scripts/preview_deck.py pipeline-converted/pipeline-stress.pptx --output-dir preview/pipeline-stress --sheet preview/pipeline-stress-sheet.png",
    "render:pipeline-stress": "python scripts/render_check.py pipeline-converted/pipeline-stress.pptx --output-dir render-check/pipeline-stress",
    "pipeline:vertical": "node pipeline/cli.js ../examples/pipeline-vertical.html --out pipeline-converted/vertical.json --pptx pipeline-converted/pipeline-vertical.pptx",
    "preview:pipeline-vertical": "python scripts/preview_deck.py pipeline-converted/pipeline-vertical.pptx --output-dir preview/pipeline-vertical --sheet preview/pipeline-vertical-sheet.png",
    "render:pipeline-vertical": "python scripts/render_check.py pipeline-converted/pipeline-vertical.pptx --output-dir render-check/pipeline-vertical",
    "pipeline:float": "node pipeline/cli.js ../examples/pipeline-float.html --out pipeline-converted/float.json --pptx pipeline-converted/pipeline-float.pptx",
    "preview:pipeline-float": "python scripts/preview_deck.py pipeline-converted/pipeline-float.pptx --output-dir preview/pipeline-float --sheet preview/pipeline-float-sheet.png",
    "render:pipeline-float": "python scripts/render_check.py pipeline-converted/pipeline-float.pptx --output-dir render-check/pipeline-float",
    "pipeline:relative": "node pipeline/cli.js ../examples/pipeline-relative.html --out pipeline-converted/relative.json --pptx pipeline-converted/pipeline-relative.pptx",
    "preview:pipeline-relative": "python scripts/preview_deck.py pipeline-converted/pipeline-relative.pptx --output-dir preview/pipeline-relative --sheet preview/pipeline-relative-sheet.png",
    "render:pipeline-relative": "python scripts/render_check.py pipeline-converted/pipeline-relative.pptx --output-dir render-check/pipeline-relative"
  },
  "dependencies": {
    "pptxgenjs": "^3.12.0",
    "fontkit": "^2.0.4",
    "image-size": "^1.2.1",
    "jszip": "^3.10.1"
  },
  "engines": {
    "node": ">=18"
  }
}
