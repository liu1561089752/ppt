{
  "name": "ppt-native-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Editable native PowerPoint generation engine for the ppt skill",
  "main": "index.js",
  "scripts": {
    "deck": "node cli.js",
    "deck:check": "node cli.js ../examples/native_deck_spec.js --check",
    "deck:example": "node cli.js ../examples/native_deck_spec.js native-deck.pptx --report native-deck.json",
    "deck:json": "node cli.js ../examples/native-cover.spec.json native-cover.pptx --report native-cover.json",
    "deck:render": "python scripts/render_check.py native-deck.pptx --output-dir render-check/native-deck",
    "lint": "node scripts/lint_static.js",
    "housekeeping": "node scripts/check_housekeeping.js",
    "test": "node scripts/lint_static.js --quiet && node --test ../tests/*.test.js",
    "demo": "node ../examples/native_demo.js native-demo.pptx",
    "demo:components": "node ../examples/native_components_demo.js native-components-demo.pptx",
    "demo:layouts": "node ../examples/native_layouts_demo.js native-layouts-demo.pptx",
    "demo:images": "node ../examples/native_images_demo.js native-images-demo.pptx",
    "demo:stress": "node ../examples/native_stress_deck.js native-stress-deck.pptx",
    "demo:theme": "node ../examples/native_design_migration_demo.js native-theme-profile/theme.json native-design-migration-demo.pptx",
    "demo:parity": "node ../examples/native_design_parity_demo.js native-theme-profile/theme.json native-design-parity-demo.pptx",
    "batch": "node ../batch_native_pptx.js --input ../examples/native_deck.json --output-dir batch-dist",
    "render:demo": "python scripts/render_check.py native-demo.pptx --output-dir render-check/native-demo",
    "render:components": "python scripts/render_check.py native-components-demo.pptx --output-dir render-check/native-components-demo",
    "render:layouts": "python scripts/render_check.py native-layouts-demo.pptx --output-dir render-check/native-layouts-demo",
    "render:images": "python scripts/render_check.py native-images-demo.pptx --output-dir render-check/native-images-demo",
    "render:stress": "python scripts/render_check.py native-stress-deck.pptx --output-dir render-check/native-stress-deck",
    "render:all": "npm run render:demo && npm run render:components && npm run render:layouts && npm run render:images && npm run render:stress && npm run render:theme && npm run render:parity",
    "audit:images": "node scripts/audit_deck.js native-images-demo.pptx",
    "audit:stress": "node scripts/audit_deck.js native-stress-deck.pptx --fail-on-warning",
    "verify:pictures": "node scripts/inspect_pictures.js native-images-demo.pptx",
    "stress": "node scripts/stress_spec.js --slides 40 --seed 7 --out stress40.pptx",
    "stress:big": "node scripts/stress_spec.js --slides 120 --seed 13 --out stress120.pptx",
    "stress:scale": "node scripts/stress_spec.js --slides 300 --seed 21 --out stress300.pptx --budget 180",
    "audit:integrity": "python scripts/verify_native_ooxml.py --self-test && python scripts/verify_native_ooxml.py stress40.pptx",
    "audit:integrity:big": "python scripts/verify_native_ooxml.py stress120.pptx",
    "audit:integrity:scale": "python scripts/verify_native_ooxml.py stress300.pptx",
    "gate:big": "npm run stress:big && npm run audit:integrity:big",
    "gate:scale": "npm run stress:scale && npm run audit:integrity:scale",
    "golden:check": "python scripts/visual_golden.py",
    "golden:update": "python scripts/visual_golden.py --update",
    "audit:text-fit": "python scripts/check_all_text_fit.py",
    "baseline:text-fit": "python scripts/check_all_text_fit.py --write-baseline",
    "limits": "node scripts/limits_report.js",
    "limits:update": "node scripts/limits_report.js --update",
    "verify:pptx": "python scripts/verify_with_python_pptx.py --deck native-deck.pptx --self-check && python scripts/verify_with_python_pptx.py --dir . --only native- --round-trip",
    "compare:renderers": "python scripts/compare_renderers.py --a render-check/native-deck --b render-wps/native-deck",
    "compare:renderers:self-check": "python scripts/compare_renderers.py --self-check",
    "compare:renderers:all": "pwsh -NoProfile -File scripts/compare_all_renderers.ps1",
    "verify:readers": "npm run compare:renderers:self-check && npm run compare:renderers:all",
    "verify:wps": "pwsh -NoProfile -File scripts/verify_all_with_wps.ps1 -Directory .",
    "render:wps": "pwsh -NoProfile -File scripts/verify_with_wps.ps1 -Deck native-deck.pptx -ExportDir render-wps/native-deck",
    "preview:deck": "python scripts/preview_deck.py native-deck.pptx --output-dir preview/native-deck --sheet preview/native-deck-sheet.png",
    "preview:demo": "python scripts/preview_deck.py native-demo.pptx --output-dir preview/native-demo --sheet preview/native-demo-sheet.png",
    "preview:components": "python scripts/preview_deck.py native-components-demo.pptx --output-dir preview/components --sheet preview/components-sheet.png",
    "preview:layouts": "python scripts/preview_deck.py native-layouts-demo.pptx --output-dir preview/layouts --sheet preview/layouts-sheet.png",
    "preview:images": "python scripts/preview_deck.py native-images-demo.pptx --output-dir preview/images --sheet preview/images-sheet.png",
    "preview:stress": "python scripts/preview_deck.py native-stress-deck.pptx --output-dir preview/stress --sheet preview/stress-sheet.png",
    "preview:all": "npm run preview:deck && npm run preview:demo && npm run preview:components && npm run preview:layouts && npm run preview:images && npm run preview:stress",
    "render:theme": "python scripts/render_check.py native-design-migration-demo.pptx --output-dir render-check/native-design-migration-demo",
    "render:parity": "python scripts/render_check.py native-design-parity-demo.pptx --output-dir render-check/native-design-parity-demo"
  },
  "dependencies": {
    "pptxgenjs": "^3.12.0",
    "fontkit": "^2.0.4",
    "image-size": "^1.2.1",
    "jszip": "^3.10.1"
  },
  "engines": {
    "node": ">=18"
  }
}
